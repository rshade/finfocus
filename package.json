{
  "name": "finfocus",
  "version": "0.1.0",
  "description": "Documentation tooling and build scripts for FinFocus",
  "private": true,
  "scripts": {
    "docs:lint": "markdownlint-cli2 --config docs/.markdownlint-cli2.jsonc 'docs/**/*.md' '#docs/_site/**' '#docs/dist/**' '#docs/.astro/**' '#docs/node_modules/**'",
    "docs:format": "prettier --write 'docs/**/*.md'",
    "docs:check-format": "prettier --check 'docs/**/*.md'",
    "docs:link-check": "node scripts/check-links.js",
    "lint": "npm run docs:lint && npm run docs:check-format"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.8.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "finops",
    "focus",
    "cost",
    "documentation"
  ],
  "author": "FinFocus Community",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
