{
  "schema_version": "1.0.0",
  "plugins": {
    "kubecost": {
      "name": "kubecost",
      "description": "Kubernetes cost analysis via Kubecost API",
      "repository": "rshade/finfocus-plugin-kubecost",
      "author": "FinFocus Team",
      "license": "Apache-2.0",
      "homepage": "https://github.com/rshade/finfocus-plugin-kubecost",
      "supported_providers": ["kubernetes"],
      "capabilities": ["cost_retrieval", "cost_projection"],
      "security_level": "official",
      "min_spec_version": "0.1.0",
      "asset_hints": {
        "asset_prefix": "finfocus-plugin-kubecost"
      }
    },
    "aws-public": {
      "name": "aws-public",
      "description": "AWS public pricing data",
      "repository": "rshade/finfocus-plugin-aws-public",
      "author": "FinFocus Team",
      "license": "Apache-2.0",
      "homepage": "https://github.com/rshade/finfocus-plugin-aws-public",
      "supported_providers": ["aws"],
      "capabilities": ["cost_projection", "pricing_specs", "recommendations"],
      "security_level": "official",
      "min_spec_version": "0.1.0",
      "asset_hints": {
        "asset_prefix": "finfocus-plugin-aws-public",
        "version_prefix": false
      }
    },
    "kubernetes": {
      "name": "kubernetes",
      "description": "Kubernetes workload usage and cost allocation by namespace, controller, pod, and label",
      "repository": "rshade/finfocus",
      "author": "FinFocus Team",
      "license": "Apache-2.0",
      "homepage": "https://github.com/rshade/finfocus/tree/main/plugins/kubernetes",
      "supported_providers": ["kubernetes"],
      "capabilities": ["usage_stats", "allocation"],
      "security_level": "official",
      "min_spec_version": "0.7.0",
      "tag_prefix": "kubernetes-",
      "asset_hints": {
        "asset_prefix": "finfocus-plugin-kubernetes"
      }
    },
    "jev": {
      "name": "jev",
      "description": "Recommendation scorer that rates risk, false positives, worth and priority and groups duplicates using TypeSafe AI's Jev model",
      "repository": "rshade/finfocus",
      "author": "FinFocus Team",
      "license": "Apache-2.0",
      "homepage": "https://github.com/rshade/finfocus/tree/main/plugins/jev",
      "supported_providers": ["*"],
      "capabilities": ["recommendation_scoring"],
      "security_level": "official",
      "min_spec_version": "0.7.0",
      "tag_prefix": "jev-",
      "asset_hints": {
        "asset_prefix": "finfocus-plugin-jev",
        "version_prefix": true
      }
    }
  }
}
