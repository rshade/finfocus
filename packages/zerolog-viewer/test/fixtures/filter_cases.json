[
  {
    "name": "empty filter matches everything",
    "entries": [
      {"seq": 1, "level": "trace", "source": "core", "message": "a"},
      {"seq": 2, "level": "panic", "source": "aws-public", "message": "b"}
    ],
    "filter": {"sources": [], "minLevel": "", "text": ""},
    "expectSeq": [1, 2]
  },
  {
    "name": "single source",
    "entries": [
      {"seq": 1, "level": "info", "source": "core", "message": "a"},
      {"seq": 2, "level": "info", "source": "aws-public", "message": "b"},
      {"seq": 3, "level": "info", "source": "kubernetes", "message": "c"}
    ],
    "filter": {"sources": ["aws-public"], "minLevel": "", "text": ""},
    "expectSeq": [2]
  },
  {
    "name": "two sources",
    "entries": [
      {"seq": 1, "level": "info", "source": "core", "message": "a"},
      {"seq": 2, "level": "info", "source": "aws-public", "message": "b"},
      {"seq": 3, "level": "info", "source": "kubernetes", "message": "c"}
    ],
    "filter": {"sources": ["core", "kubernetes"], "minLevel": "", "text": ""},
    "expectSeq": [1, 3]
  },
  {
    "name": "unknown source selects nothing",
    "entries": [
      {"seq": 1, "level": "info", "source": "core", "message": "a"}
    ],
    "filter": {"sources": ["missing"], "minLevel": "", "text": ""},
    "expectSeq": []
  },
  {
    "name": "min level trace",
    "entries": [
      {"seq": 1, "level": "trace", "source": "core", "message": "a"},
      {"seq": 2, "level": "debug", "source": "core", "message": "a"},
      {"seq": 3, "level": "info", "source": "core", "message": "a"},
      {"seq": 4, "level": "warn", "source": "core", "message": "a"},
      {"seq": 5, "level": "error", "source": "core", "message": "a"},
      {"seq": 6, "level": "fatal", "source": "core", "message": "a"},
      {"seq": 7, "level": "panic", "source": "core", "message": "a"}
    ],
    "filter": {"sources": [], "minLevel": "trace", "text": ""},
    "expectSeq": [1, 2, 3, 4, 5, 6, 7]
  },
  {
    "name": "min level debug",
    "entries": [
      {"seq": 1, "level": "trace", "source": "core", "message": "a"},
      {"seq": 2, "level": "debug", "source": "core", "message": "a"},
      {"seq": 3, "level": "info", "source": "core", "message": "a"},
      {"seq": 4, "level": "warn", "source": "core", "message": "a"},
      {"seq": 5, "level": "error", "source": "core", "message": "a"},
      {"seq": 6, "level": "fatal", "source": "core", "message": "a"},
      {"seq": 7, "level": "panic", "source": "core", "message": "a"}
    ],
    "filter": {"sources": [], "minLevel": "debug", "text": ""},
    "expectSeq": [2, 3, 4, 5, 6, 7]
  },
  {
    "name": "min level info",
    "entries": [
      {"seq": 1, "level": "trace", "source": "core", "message": "a"},
      {"seq": 2, "level": "debug", "source": "core", "message": "a"},
      {"seq": 3, "level": "info", "source": "core", "message": "a"},
      {"seq": 4, "level": "warn", "source": "core", "message": "a"},
      {"seq": 5, "level": "error", "source": "core", "message": "a"},
      {"seq": 6, "level": "fatal", "source": "core", "message": "a"},
      {"seq": 7, "level": "panic", "source": "core", "message": "a"}
    ],
    "filter": {"sources": [], "minLevel": "info", "text": ""},
