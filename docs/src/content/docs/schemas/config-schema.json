{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rshade.github.io/finfocus/schemas/config.json",
  "title": "FinFocus Configuration",
  "description": "Configuration file for FinFocus CLI tool",
  "type": "object",
  "properties": {
    "cost": {
      "type": "object",
      "description": "Cost management settings",
      "properties": {
        "budgets": {
          "type": "object",
          "description": "Budget thresholds and alerts. The applied scope is global, providers, tags, or types.",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0,
              "description": "Not applied. Set cost.budgets.global.amount. Zero disables a scope."
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "Not applied. Set cost.budgets.global.currency. Three uppercase letters."
            },
            "period": {
              "type": "string",
              "enum": ["monthly"],
              "description": "Not applied. Set cost.budgets.global.period. The only supported period is monthly."
            },
            "alerts": {
              "type": "array",
              "minItems": 1,
              "description": "Not applied. Set cost.budgets.global.alerts. Omit alerts, or include at least one.",
              "items": {
                "$ref": "#/definitions/BudgetAlert"
              }
            },
            "global": {
              "$ref": "#/definitions/ScopedBudget"
            },
            "providers": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/ScopedBudget"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TagBudget"
              }
            },
            "types": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/ScopedBudget"
              }
            },
            "exit_on_threshold": {
              "type": "boolean",
              "description": "Exit non-zero when a threshold is exceeded, unless a scope overrides it."
            },
            "exit_code": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "Process exit code used when exit_on_threshold is set."
            }
          }
        }
      }
    },
    "tui": {
      "type": "object",
      "description": "Terminal UI and accessibility settings",
      "properties": {
        "adaptive_colors": {
          "type": "boolean",
          "default": true,
          "description": "Enable adaptive color schemes based on terminal background"
        },
        "color_scheme": {
          "type": "string",
          "enum": ["auto", "light", "dark"],
          "default": "auto",
          "description": "Force specific color scheme"
        },
        "plain": {
          "type": "boolean",
          "default": false,
          "description": "Enable plain text mode (disable TUI)"
        },
        "high_contrast": {
          "type": "boolean",
          "default": false,
          "description": "Enable high contrast mode"
        }
      }
    }
  },
  "definitions": {
    "BudgetAlert": {
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "Percentage of budget at which to trigger alert (0-1000)"
        },
        "type": {
          "type": "string",
          "enum": ["actual", "forecasted"],
          "description": "Alert trigger type: actual (current costs) or forecasted (projected)"
        },
        "notifications": {
          "type": "array",
          "description": "Destinations notified when this threshold is exceeded in a run with --notify or FINFOCUS_NOTIFY=true.",
          "items": {
            "$ref": "#/definitions/NotificationDestination"
          }
        }
      },
      "required": ["threshold", "type"]
    },
    "ScopedBudget": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "description": "Budget amount. Zero disables the scope and skips further checks."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of three uppercase letters. Empty inherits the global currency."
        },
        "period": {
          "type": "string",
          "enum": ["monthly"],
          "description": "The only supported period is monthly."
        },
        "alerts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/BudgetAlert"
          }
        },
        "exit_on_threshold": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "TagBudget": {
      "allOf": [
        {
          "$ref": "#/definitions/ScopedBudget"
        },
        {
          "type": "object",
          "properties": {
            "selector": {
              "type": "string",
              "description": "Tag selector in key:value or key:* form."
            },
            "priority": {
              "type": "integer"
            }
          },
          "required": ["selector"]
        }
      ]
    },
    "NotificationDestination": {
      "type": "object",
      "description": "A budget alert destination. url and header values are secrets; use ${FINFOCUS_NOTIFY_*} references in the global config. Project configs must use literal values.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["slack", "webhook"],
          "description": "slack (incoming webhook) or webhook (generic HTTPS endpoint)."
        },
        "url": {
          "type": "string",
          "pattern": "^(https://|.*\\$\\{FINFOCUS_NOTIFY_[A-Za-z0-9_]+\\})",
          "description": "https:// URL with a host, or a value using ${FINFOCUS_NOTIFY_*} references (checked for HTTPS after expansion)."
        },
        "channel": {
          "type": "string",
          "description": "Slack only. Channel override sent with the message."
        },
        "method": {
          "type": "string",
          "enum": ["POST", "PUT", "post", "put", "Post", "Put"],
          "description": "Webhook only. HTTP method, POST by default."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Webhook only. Extra request headers; values may use ${FINFOCUS_NOTIFY_*} references."
        }
      },
      "required": ["type", "url"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "slack"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["method"]
                },
                {
                  "required": ["headers"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "webhook"
              }
            }
          },
          "then": {
            "not": {
              "required": ["channel"]
            }
          }
        }
      ]
    }
  }
}
